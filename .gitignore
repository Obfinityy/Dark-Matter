.agents
brag-output-infinity-ad

# Runtime artifacts (computer screenshots, generated reports/data)
data/
# ...but NOT the frontend's static data modules
!frontend/src/data/
# Project-local virtualenv for the computer bridge (keeps pyautogui out of system Python)
.venv/

# Dependencies
node_modules/
# Staging dir for backend/scripts/install-deps.sh (the script cleans it
# up; ignored so a killed run never shows up as untracked clutter)
.node_modules.staging/

# Logs
*.log
npm-debug.log*

# Local env files (never commit real values; .env.example is the template)
.env
.env.local
.env.*.local

# Python cache
__pycache__/
*.pyc
*.pyo

# local dev symlink aid (not a real directory)
node_modules
.e2e-tmp/
