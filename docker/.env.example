# Dark Matter hunt engine — copy to .env (setup-linux.sh does this for you)
# NEVER commit a filled-in .env — it holds secrets.

# --- Postgres ---
POSTGRES_USER=pentagiuser
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=pentagidb

# --- Engine ---
# Host port for the engine API (contract default: 8080 -> http://localhost:8080)
ENGINE_PORT=8080
# Signing salt for sessions + API tokens. setup-linux.sh generates a random one.
# Changing it later INVALIDATES all minted tokens (ENGINE_TOKEN must be re-minted).
COOKIE_SIGNING_SALT=
# Optional multi-tenant namespace; leave empty for a single instance.
TENANT_ID=

# --- Bearer token for the engine API (contract: ENGINE_TOKEN) ---
# Minted by setup-linux.sh via the mint-engine-token tool and written here.
# The Dark Matter backend sends it as: Authorization: Bearer <ENGINE_TOKEN>
ENGINE_TOKEN=

# --- LLM: custom OpenAI-compatible provider (no external API key required) ---
# URL of the OpenAI-compatible server. Default: local Ollama.
# NOTE: this URL is resolved FROM INSIDE the engine container. For Ollama
# running on the same host, use: http://host.docker.internal:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
# Optional API key for the LLM server. May be empty for Ollama — the engine
# requires a non-empty value, so setup-linux.sh substitutes "ollama".
LLM_API_KEY=
# Model served at LLM_BASE_URL.
LLM_MODEL=qwen3:32b

# --- Hunt sandbox ---
# Default container image for pentest tool sandboxes (pulled on demand).
DOCKER_DEFAULT_IMAGE=debian:latest

DEBUG=false
