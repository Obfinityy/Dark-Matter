# Dark Matter per-hunt container image — the agent's "computer".
# Each hunt gets a FRESH, ISOLATED Kali Linux container from this image.
# Spawned by backend/src/huntRunner.js on hunt creation, destroyed on completion.
#
# The container is the agent's hands: the HuntOrchestrator (head) directs
# specialist workers THROUGH this container via `docker exec` — like a human
# hacker's brain directing their hands on the keyboard. It can:
#   - scan and enumerate (nmap, subfinder, amass, nikto)
#   - test web vulns (sqlmap, nuclei, xsstrike-style manual payloads)
#   - browse like a human (chromium + selenium for JS-heavy targets)
#   - crack and analyze (john, hashcat-lite, jwt tools)
#   - write and run custom exploit scripts (python3, nodejs)
#
# Build: docker build -f docker/Dockerfile.hunt -t darkmatter/hunt:latest .

FROM kalilinux/kali-rolling

ENV DEBIAN_FRONTEND=noninteractive
# HUNTER-MIND timing fix (26 Oct 2026): the container's clocks are NOT
# skewed — the bug is DISPLAY (no TZ set, so the XFCE clock shows UTC,
# 5:30 behind the owner's IST wall clock). tzdata + TZ here bake IST
# into the NEXT image rebuild; the runtime spawn path (huntRunner.js:
# -e TZ + host zoneinfo mount) fixes the CURRENT container without a
# rebuild. This image is NOT rebuilt in this lane.
ENV TZ=Asia/Kolkata

RUN apt-get update && apt-get install -y --no-install-recommends \
    tzdata \
    python3 python3-pip nodejs npm curl wget git jq \
    nmap nikto sqlmap \
    subfinder amass \
    chromium chromium-driver \
    john hashcat \
    dnsutils net-tools iputils-ping \
    && rm -rf /var/lib/apt/lists/*

# Python hacking libs
RUN pip3 install --no-cache-dir --break-system-packages \
    requests beautifulsoup4 selenium webdriver-manager \
    pyjwt python-whois dnspython \
    || true

# --- Live terminal streaming (PiP) ---
# ttyd: single static binary, serves the agent's PTY over WebSocket (read-only).
# tmux: persistent shell session so the streamed terminal shows actual agent activity.
RUN curl -sL https://github.com/tsl0922/ttyd/releases/download/1.7.7/ttyd.x86_64 \
    -o /usr/local/bin/ttyd && chmod +x /usr/local/bin/ttyd || true
RUN apt-get update && apt-get install -y --no-install-recommends tmux \
    && rm -rf /var/lib/apt/lists/* || true

# --- Live GUI desktop ("Live Machine") — FULL XFCE desktop -------------------
# A real desktop the agent can drive and the owner can watch AND use:
#   xvfb      virtual display :99 (no physical screen on the host)
#   xfce4     FULL desktop — panel, applications menu, desktop icons,
#             file manager (thunar), terminal (xfce4-terminal). Owner
#             order 25 Oct 2026: "terminal nahi, poora GUI chahiye" —
#             fluxbox (a bare window manager + thin taskbar) was
#             replaced because the live check showed a black screen
#             with no wallpaper, no icons, no menu, nothing clickable.
#             XFCE core only (xfce4 + panel + desktop + thunar +
#             terminal); NOT the kali-desktop-xfce metapackage, NOT
#             GNOME/KDE.
#   x11vnc    VNC server, always started -viewonly + loopback-only by
#             docker/hunt-desktop.sh (viewing never grants control).
#   websockify + novnc   browser VNC client plumbing for the v2 streaming
#             viewer (v1 viewing is the backend screenshot route).
#   xdotool   the agent's GUI hands (mouse/keyboard) inside its sandbox.
#   scrot     screenshot capture for GET /api/v1/hunts/:id/desktop.jpg.
#   dbus-x11 + x11-xserver-utils: Chromium-under-Xvfb plumbing.
#   xterm     lightweight terminal emulator, kept alongside
#             xfce4-terminal (the agent/owner terminal; Ctrl+Alt+T is
#             wired to xfce4-terminal in hunt-desktop.sh).
#   xfonts-base  xterm's default bitmap font (misc-fixed) — with
#             --no-install-recommends it is NOT pulled in, and xterm then
#             fails to open with "cannot load font" (verified in a test
#             container 25 Oct 2026).
#   fonts-dejavu-core + adwaita-icon-theme + hicolor-icon-theme:
#             GTK text + menu/panel icons — without them the XFCE panel
#             and applications menu render blank.
# The stack is started ON DEMAND by huntRunner.startHuntDesktop (docker
# exec of hunt-desktop.sh) — nothing here runs at container boot, so
# ordinary hunts are not slowed. Estimated image growth: XFCE ~+250 MB.
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb x11vnc websockify novnc \
    xfce4 xfce4-panel xfdesktop4 thunar xfce4-terminal xfconf xfce4-settings \
    xdotool scrot dbus-x11 x11-xserver-utils \
    xterm xfonts-base fonts-dejavu-core adwaita-icon-theme hicolor-icon-theme \
    && rm -rf /var/lib/apt/lists/*

# --- Hacking tools with a GUI (owner order 25 Oct 2026) --------------------
# Burp Suite (Community) + Wireshark — the two tools the owner named.
# They were missing from the image (verified live 25 Oct 2026: only
# nmap/nikto/sqlmap/mitmproxy were present). Both ship their own
# .desktop entries, so they appear in the XFCE applications menu.
# Burp pulls a JRE (the big cost here); Wireshark pulls Qt. Metasploit
# (msfconsole) lives in the FULL-toolset late layer below (owner order
# 25 Oct 2026) — it was deliberately NOT here because the EC2 disk
# (48 GB, ~5 GB free) is tight; the late layer measures it first.
RUN apt-get update && apt-get install -y --no-install-recommends \
    burpsuite wireshark \
    && rm -rf /var/lib/apt/lists/*

# --- Extra CLI hacking tools (late layer — keep early layers cached) -----
# nuclei/gobuster/hydra live in their OWN late RUN on purpose: adding
# them to the first apt block would invalidate every layer after it
# and force a ~3.5 GB rebuild on a disk with ~5 GB free (the first
# XFCE build attempt died exactly that way — disk-full at 100%).
# A late layer keeps future rebuilds cheap.
RUN apt-get update && apt-get install -y --no-install-recommends \
    nuclei gobuster hydra \
    && rm -rf /var/lib/apt/lists/*

# --- Screen-seeing OCR (owner order 27 Oct 2026, ~13:45 IST) ----------------
# The agent looks at the screen itself and controls from what it sees.
# tesseract-ocr turns a scrot screenshot into words + coordinates (TSV),
# which the text-only 8B brain reads as a screen map (backend/src/screenMap.js).
# Own late RUN so it does not invalidate the layers above. AT-SPI
# (at-spi2-core + python3-pyatspi + libatk-wrapper-java) is the pending owner
# decision — when approved it arrives here, in this same layer, for
# named-control clicks inside GUI apps (the OCR layer alone cannot name a
# control or tell a button from a label).
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

# --- FULL Kali toolset (owner order 25 Oct 2026, ~21:50 IST) ---------------
# The owner tested the desktop himself: "Kali jaisa nahi lag raha" — this
# was a minimal Kali, not real Kali. This lane installs the standard Kali
# arsenal. Disk is the constraint (EC2 48G, ~5.3G free, floor >=1.5G free
# after install), so metapackages are NOT installed whole — measured
# 25 Oct 2026 (apt -s + Installed-Size sums, inside a throwaway container
# from this image; this apt prints no size summary in -s mode):
#   kali-tools-top10                  1,894 MB installed (mostly metasploit 1,750 MB)
#   kali-tools-web                    4,309 MB (apache2 + mysql-server + php + beef-xss + maltego — kitchen sink, does NOT fit)
#   kali-tools-information-gathering  2,859 MB (does NOT fit whole)
#   kali-tools-passwords              2,718 MB (incl. kali-tools-gpu + seclists/wordlists 1,896 MB — does NOT fit whole)
#   kali-tools-vulnerability          2,523 MB (incl. gvm/OpenVAS + afl++/llvm — does NOT fit whole)
#   all four metapackages             6,610 MB (does NOT fit)
#   the individual missing-list packages (these layers) ~2,974 MB
# So: kali-tools-top10 as the metapackage (it IS the canonical top-10 and
# its new content is exactly aircrack-ng + metasploit-framework + netexec
# + responder), everything else as individual packages. seclists/wordlists
# (1,896 MB) and the metapackages' extra breadth are deliberately skipped
# — reported, not silently dropped. man-db is non-negotiable (owner typed
# `man` in the terminal and got "man: not found" — man pages exist under
# /usr/share/man but the binary was missing).
# Each RUN ends with apt-get clean + rm of lists/archives so .debs never
# bloat the layer. Split into two RUNs so a disk failure in the second
# still leaves a usable image with Metasploit in it.
RUN apt-get update && apt-get install -y --no-install-recommends \
    man-db kali-tools-top10 \
    && apt-get clean && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*
RUN apt-get update && apt-get install -y --no-install-recommends \
    tshark ffuf dirb enum4linux smbmap impacket-scripts ncrack zaproxy \
    sqlninja wpscan theharvester recon-ng httpx-toolkit katana dalfox \
    xsstrike commix bloodhound neo4j \
    && apt-get clean && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# ysoserial is NOT in Kali apt — GitHub release jar (v0.0.6, ~57MB) + a
# wrapper on PATH. Best-effort (|| true): if the download fails the build
# still succeeds and ysoserial is reported MISS.
RUN mkdir -p /usr/local/share && curl -sL https://github.com/frohoff/ysoserial/releases/download/v0.0.6/ysoserial-all.jar \
    -o /usr/local/share/ysoserial-all.jar \
    && printf '#!/bin/sh\nexec java -jar /usr/local/share/ysoserial-all.jar "$@"\n' > /usr/local/bin/ysoserial \
    && chmod +x /usr/local/bin/ysoserial || true

# --- Applications-menu entries for the CLI tools ---------------------------
# nmap/nikto/sqlmap/nuclei/gobuster/hydra + the FULL-toolset CLI tools have
# no GUI and ship no .desktop file, so the XFCE menu would hide them. These
# entries open each tool in a terminal that stays open afterwards (bash
# re-execs after the tool exits, so a no-args help dump does not flash away).
# Notes: httpx-toolkit installs the binary as `httpx`; impacket-scripts is
# a suite (secretsdump.py, psexec.py, GetUserSPNs.py...) so it gets one entry
# that opens a terminal; neo4j is a service (`neo4j console`) with no menu
# entry by design; zaproxy gets an entry ONLY if the package ships none.
RUN for t in nmap nikto sqlmap nuclei gobuster hydra ffuf dirb enum4linux smbmap netexec responder ncrack sqlninja wpscan theharvester recon-ng httpx katana dalfox xsstrike commix aircrack-ng tshark msfconsole bloodhound ysoserial; do \
      printf '[Desktop Entry]\nType=Application\nName=%s\nComment=Hacking tool (terminal)\nExec=bash -c "%s; exec bash"\nTerminal=true\nIcon=utilities-terminal\nCategories=System;\n' "$t" "$t" > "/usr/share/applications/$t.desktop"; \
    done; \
    printf '[Desktop Entry]\nType=Application\nName=Impacket\nComment=Network protocol toolkit (secretsdump.py, psexec.py, GetUserSPNs.py)\nExec=bash\nTerminal=true\nIcon=utilities-terminal\nCategories=System;\n' > /usr/share/applications/impacket.desktop; \
    if ! ls /usr/share/applications/*zap* /usr/share/applications/*zaproxy* >/dev/null 2>&1; then \
      printf '[Desktop Entry]\nType=Application\nName=OWASP ZAP\nComment=Web application security scanner (ZAP)\nExec=zaproxy\nTerminal=false\nCategories=Network;Security;\n' > /usr/share/applications/zaproxy.desktop; \
    fi; \
    printf '[Desktop Entry]\nType=Application\nName=Burp Suite\nComment=Web application security testing (Community Edition)\nExec=burpsuite\nTerminal=false\nCategories=Network;Security;\n' > /usr/share/applications/burpsuite.desktop
# NOTE: Kali's burpsuite package ships NO .desktop file (verified:
# dpkg -L burpsuite lists only /usr/bin/burpsuite + the jar), so the
# entry above is written by hand — without it Burp Suite would not
# appear in the XFCE applications menu at all. Wireshark DOES ship
# org.wireshark.Wireshark.desktop, so it needs no hand-written entry.

# --- Real Kali look (owner order 25 Oct 2026, ~23:16 IST) ------------------
# The owner: "abhi bhi jo kali linux aa raha hai na, wo real wala kali
# linux nahi aa raha hai" — the desktop underneath IS latest kali-rolling
# (2026-10-18 base, VERSION_ID 2026.3) but it wears plain stock-XFCE
# clothes (light panel, XFCE mouse logo, plain wallpaper), while his laptop
# Kali has Kali's dark theme, dragon wallpaper and dragon menu logo.
# This layer installs ONLY the look — measured 25 Oct 2026 from the
# kali-rolling Packages index (Depends-only closure vs this image):
#   kali-themes              ~123 MB (Kali-Dark GTK + xfwm4 themes,
#                             Flat-Remix-Blue-Dark icons incl. the
#                             kali-panel-menu dragon, kali-cubes dragon
#                             wallpaper, Cantarell/Fira Code fonts)
#   kali-menu                ~10 MB (Kali menu categories)
#   xfce4-whiskermenu-plugin ~1 MB (the dragon menu button)
#   xfce4-cpugraph-plugin / xfce4-genmon-plugin / xfce4-notifyd /
#   xfce4-power-manager-plugins / xfce4-pulseaudio-plugin (0-16 MB —
#   the remaining plugins in Kali's default panel)
#   qterminal ~4 MB (Kali's default terminal; helpers.rc points at it)
#   mousepad ~13 MB (the text-editor launcher in Kali's panel)
#   LEAN TOTAL ~170 MB.
# Deliberately NOT kali-desktop-xfce: its closure is ~950 MB and drags
# firefox-esr (~293 MB — Chromium is already the browser), libwebkit2gtk
# (~126 MB), atril/parole/ristretto/engrampa, pipewire-pulse,
# network-manager and lightdm (a display manager — we run Xvfb +
# startxfce4 directly, no DM). The owner also ordered "faltu ka space
# mat bhare" (25 Oct 2026) — ~780 MB of unused apps is exactly that.
# How it takes effect: kali-themes' postinst COPIES Kali's XFCE defaults
# to /etc/xdg on install (panel/default.xml with whiskermenu first,
# whiskermenu/defaults.rc with button-icon=kali-panel-menu, xfconf
# perchannel defaults: xsettings Kali-Dark/Flat-Remix-Blue-Dark, xfwm4
# Kali-Dark, xfce4-desktop wallpaper /usr/share/backgrounds/kali-16x9/
# default = kali-cubes.jpg, zoomed) — so a fresh session looks like Kali
# with no further steps. hunt-desktop.sh ALSO enforces the same settings
# on the live session via xfconf-query (heals a session that started with
# stock values). Its postinst also runs `update-initramfs -u` (via the
# plymouth-label dep) — safe in a container: update-initramfs 0.151 exits
# 0 with "Nothing to do" when no /boot/initrd.img-* exists (verified
# from the shipped script). lightdm is never installed or started.
RUN apt-get update && apt-get install -y --no-install-recommends \
    kali-themes kali-menu xfce4-whiskermenu-plugin \
    xfce4-cpugraph-plugin xfce4-genmon-plugin xfce4-notifyd \
    xfce4-power-manager-plugins xfce4-pulseaudio-plugin \
    qterminal mousepad \
    && apt-get clean && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*
COPY docker/hunt-desktop.sh /usr/local/bin/hunt-desktop.sh
RUN chmod +x /usr/local/bin/hunt-desktop.sh

# --- Intercepting proxy (Lane U) ---
# mitmproxy gives the hunter a Burp-style intercept workflow at its
# own machine: proxy_start (backend/src/proxyIntercept.js) runs
# mitmweb INSIDE this container, re-routes this Chromium through it,
# and the hunter inspects/replays captured requests from a JSONL
# capture — the dashboard is a web page it opens in this same
# browser. Kali ships mitmproxy in apt; pip is the fallback. The
# capture addon itself is NOT baked in — the backend injects the
# repo's single canonical copy at proxy start (the guiTools pattern),
# so image and backend can never drift apart on it.
RUN (apt-get update && apt-get install -y --no-install-recommends mitmproxy \
    && rm -rf /var/lib/apt/lists/*) \
    || pip3 install --no-cache-dir --break-system-packages mitmproxy \
    || true

WORKDIR /opt/hunt
COPY docker/hunt-runner/ ./

RUN chmod +x run.sh && npm install --omit=dev || true

ENTRYPOINT ["/opt/hunt/run.sh"]
