# Dark Matter per-hunt container image — the agent's "computer".
# Each hunt gets a FRESH, ISOLATED Kali Linux container from this image.
# Spawned by backend/src/huntRunner.js on hunt creation, destroyed on completion.
#
# The container is the agent's hands: the HuntOrchestrator (head) directs
# specialist workers THROUGH this container via `docker exec` — like a human
# hacker's brain directing their hands on the keyboard. It can:
#   - scan and enumerate (nmap, subfinder, amass, nikto)
#   - test web vulns (sqlmap, nuclei, xsstrike-style manual payloads)
#   - browse like a human (chromium + selenium for JS-heavy targets)
#   - crack and analyze (john, hashcat-lite, jwt tools)
#   - write and run custom exploit scripts (python3, nodejs)
#
# Build: docker build -f docker/Dockerfile.hunt -t darkmatter/hunt:latest .

FROM kalilinux/kali-rolling

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip nodejs npm curl wget git jq \
    nmap nikto sqlmap nuclei gobuster hydra \
    subfinder amass \
    chromium chromium-driver \
    john hashcat \
    dnsutils net-tools iputils-ping \
    && rm -rf /var/lib/apt/lists/*

# Python hacking libs
RUN pip3 install --no-cache-dir --break-system-packages \
    requests beautifulsoup4 selenium webdriver-manager \
    pyjwt python-whois dnspython \
    || true

# --- Live terminal streaming (PiP) ---
# ttyd: single static binary, serves the agent's PTY over WebSocket (read-only).
# tmux: persistent shell session so the streamed terminal shows actual agent activity.
RUN curl -sL https://github.com/tsl0922/ttyd/releases/download/1.7.7/ttyd.x86_64 \
    -o /usr/local/bin/ttyd && chmod +x /usr/local/bin/ttyd || true
RUN apt-get update && apt-get install -y --no-install-recommends tmux \
    && rm -rf /var/lib/apt/lists/* || true

# --- Live GUI desktop ("Live Machine") — FULL XFCE desktop -------------------
# A real desktop the agent can drive and the owner can watch AND use:
#   xvfb      virtual display :99 (no physical screen on the host)
#   xfce4     FULL desktop — panel, applications menu, desktop icons,
#             file manager (thunar), terminal (xfce4-terminal). Owner
#             order 25 Oct 2026: "terminal nahi, poora GUI chahiye" —
#             fluxbox (a bare window manager + thin taskbar) was
#             replaced because the live check showed a black screen
#             with no wallpaper, no icons, no menu, nothing clickable.
#             XFCE core only (xfce4 + panel + desktop + thunar +
#             terminal); NOT the kali-desktop-xfce metapackage, NOT
#             GNOME/KDE.
#   x11vnc    VNC server, always started -viewonly + loopback-only by
#             docker/hunt-desktop.sh (viewing never grants control).
#   websockify + novnc   browser VNC client plumbing for the v2 streaming
#             viewer (v1 viewing is the backend screenshot route).
#   xdotool   the agent's GUI hands (mouse/keyboard) inside its sandbox.
#   scrot     screenshot capture for GET /api/v1/hunts/:id/desktop.jpg.
#   dbus-x11 + x11-xserver-utils: Chromium-under-Xvfb plumbing.
#   xterm     lightweight terminal emulator, kept alongside
#             xfce4-terminal (the agent/owner terminal; Ctrl+Alt+T is
#             wired to xfce4-terminal in hunt-desktop.sh).
#   xfonts-base  xterm's default bitmap font (misc-fixed) — with
#             --no-install-recommends it is NOT pulled in, and xterm then
#             fails to open with "cannot load font" (verified in a test
#             container 25 Oct 2026).
#   fonts-dejavu-core + adwaita-icon-theme + hicolor-icon-theme:
#             GTK text + menu/panel icons — without them the XFCE panel
#             and applications menu render blank.
# The stack is started ON DEMAND by huntRunner.startHuntDesktop (docker
# exec of hunt-desktop.sh) — nothing here runs at container boot, so
# ordinary hunts are not slowed. Estimated image growth: XFCE ~+250 MB.
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb x11vnc websockify novnc \
    xfce4 xfce4-panel xfdesktop4 thunar xfce4-terminal xfconf xfce4-settings \
    xdotool scrot dbus-x11 x11-xserver-utils \
    xterm xfonts-base fonts-dejavu-core adwaita-icon-theme hicolor-icon-theme \
    && rm -rf /var/lib/apt/lists/*

# --- Hacking tools with a GUI (owner order 25 Oct 2026) --------------------
# Burp Suite (Community) + Wireshark — the two tools the owner named.
# They were missing from the image (verified live 25 Oct 2026: only
# nmap/nikto/sqlmap/mitmproxy were present). Both ship their own
# .desktop entries, so they appear in the XFCE applications menu.
# Burp pulls a JRE (the big cost here); Wireshark pulls Qt. Metasploit
# (msfconsole, ~1 GB+) is deliberately NOT installed — the EC2 disk
# (48 GB, ~5 GB free) cannot afford it; say so, do not silently add it.
RUN apt-get update && apt-get install -y --no-install-recommends \
    burpsuite wireshark \
    && rm -rf /var/lib/apt/lists/*

# --- Applications-menu entries for the CLI tools ---------------------------
# nmap/nikto/sqlmap/nuclei/gobuster/hydra have no GUI and ship no
# .desktop file, so the XFCE menu would hide them. These entries open
# each tool in a terminal that stays open afterwards (bash re-execs
# after the tool exits, so a no-args help dump does not flash away).
RUN for t in nmap nikto sqlmap nuclei gobuster hydra; do \
      printf '[Desktop Entry]\nType=Application\nName=%s\nComment=Hacking tool (terminal)\nExec=bash -c "%s; exec bash"\nTerminal=true\nIcon=utilities-terminal\nCategories=System;\n' "$t" "$t" > "/usr/share/applications/$t.desktop"; \
    done
COPY docker/hunt-desktop.sh /usr/local/bin/hunt-desktop.sh
RUN chmod +x /usr/local/bin/hunt-desktop.sh

# --- Intercepting proxy (Lane U) ---
# mitmproxy gives the hunter a Burp-style intercept workflow at its
# own machine: proxy_start (backend/src/proxyIntercept.js) runs
# mitmweb INSIDE this container, re-routes this Chromium through it,
# and the hunter inspects/replays captured requests from a JSONL
# capture — the dashboard is a web page it opens in this same
# browser. Kali ships mitmproxy in apt; pip is the fallback. The
# capture addon itself is NOT baked in — the backend injects the
# repo's single canonical copy at proxy start (the guiTools pattern),
# so image and backend can never drift apart on it.
RUN (apt-get update && apt-get install -y --no-install-recommends mitmproxy \
    && rm -rf /var/lib/apt/lists/*) \
    || pip3 install --no-cache-dir --break-system-packages mitmproxy \
    || true

WORKDIR /opt/hunt
COPY docker/hunt-runner/ ./

RUN chmod +x run.sh && npm install --omit=dev || true

ENTRYPOINT ["/opt/hunt/run.sh"]
