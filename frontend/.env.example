# ── Dark-Matter Frontend — environment variables ─────────────────────────
# Copy this file to `.env` and fill in your values.
# Vite only exposes variables prefixed with VITE_ to the browser.
# NOTE: anything here ships inside the built JS — never put secrets in VITE_ vars.

# ── Backend URL — THE rule ───────────────────────────────────────────────
# If VITE_BACKEND_URL is set, EVERY backend request goes to that URL.
# If it is empty / not set, requests go to http://localhost:4000 (your
# local backend — run `npm start` in backend/).
# There is no Localhost/Cloud switch in the app anymore; the URL is decided
# here, once, at build time.
#
# Value = backend origin WITHOUT /api/v1 (the app appends it).
# Example — Infinity AI Cloud on Render:
#   VITE_BACKEND_URL=https://dark-matter-90nw.onrender.com
VITE_BACKEND_URL=
