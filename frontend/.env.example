# ── Dark-Matter Frontend — environment variables ─────────────────────────
# Copy this file to `.env` and fill in your values.
# Vite only exposes variables prefixed with VITE_ to the browser.
# NOTE: anything here ships inside the built JS — never put secrets in VITE_ vars.

# Default cloud backend URL (no trailing slash).
# Baked into the build. The deployed site talks to this backend out of the box.
# The user can still override it anytime in Settings → Backend (localStorage wins).
# Example after you deploy the backend on Vercel:
#   VITE_DEFAULT_VERCEL_URL=https://dark-matter-backend.vercel.app
VITE_DEFAULT_VERCEL_URL=

# Which backend mode the app starts in on a fresh device: localhost | vercel
# (Once the user picks a mode in Settings, their choice is remembered.)
VITE_DEFAULT_BACKEND_MODE=localhost

# Localhost backend base URL (only used when mode is localhost).
# Change only if your backend runs on a different host/port.
VITE_LOCALHOST_API_URL=http://localhost:4000/api/v1
