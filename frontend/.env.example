# ── Dark-Matter Frontend — environment variables ─────────────────────────
# Copy this file to `.env` and fill in your values.
# Vite only exposes variables prefixed with VITE_ to the browser.
# NOTE: anything here ships inside the built JS — never put secrets in VITE_ vars.

# ── Backend URL — THE rule ───────────────────────────────────────────────
# VITE_API_BASE_URL is the canonical variable: when set, EVERY backend
# request goes to that URL (resolved once in src/lib/apiBase.js).
# The legacy VITE_BACKEND_URL is still honoured as a fallback.
# With neither set, requests go to http://localhost:4000 (your local
# backend — run `npm start` in backend/).
# There is no Localhost/Cloud switch in the app; the URL is decided
# here, once, at build time.
#
# Value = backend origin WITHOUT /api/v1 (the app appends it).
# Example — Infinity AI Cloud on Render:
VITE_API_BASE_URL=https://dark-matter-90nw.onrender.com

# Legacy alias (kept for existing deployments; VITE_API_BASE_URL wins).
VITE_BACKEND_URL=
