# Production build env — baked in by `vite build` (Vercel).
# The deployed site talks to the Infinity AI Cloud backend on Render.
# A Vercel project env var with the same name would override this.
# Local dev (`npm run dev`) ignores this file and falls back to localhost:4000.
VITE_API_BASE_URL=https://nngbffkn-4000.inc1.devtunnels.ms
VITE_BACKEND_URL=https://nngbffkn-4000.inc1.devtunnels.ms
