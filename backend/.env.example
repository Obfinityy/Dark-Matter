# Dark Matter backend — copy to .env and fill in. NEVER commit .env.
PORT=4000
JWT_SECRET=change-me-to-32-plus-random-chars

# Admin bootstrap (generate via: node scripts/make-admin-hash.js)
ADMIN_USERNAME=bhavesh189
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD_SALT=

# LLM provider: bedrock (default) or ollama (locally hosted uncensored model)
LLM_PROVIDER=bedrock
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=dolphin-mistral:7b

# AWS Bedrock (connected BY DEFAULT — owner's account)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL=meta.llama3-1-70b-instruct-v1:0

# Hunt engine (PentAGI)
ENGINE_URL=http://127.0.0.1:8080

# Hunt containers — one isolated container ("VM") auto-spawned per hunt.
# Built via: docker build -f docker/Dockerfile.hunt -t darkmatter/hunt:latest .
HUNT_IMAGE=darkmatter/hunt:latest
HUNT_MEMORY=4g
HUNT_CPUS=1.5
HUNT_TIMEOUT_MS=21600000
# Max Bedrock spend per hunt before the agent loop stops itself
HUNT_BUDGET_USD=25

# CORS
CORS_ORIGINS=https://darkmatter.yourdomain.com

# Trust proxy (rate limiters key on req.ip): set TRUST_PROXY=1 when the
# backend runs behind a trusted proxy (nginx). NEVER set it on a
# directly exposed box — clients could spoof X-Forwarded-For and dodge
# the login/signup/claims limiters. Leave unset for direct/EC2 deploys.
# TRUST_PROXY=1

# Razorpay auto-payment (issue #491) — TEST MODE ONLY.
# Create free test keys: Razorpay Dashboard (email signup) -> API Keys ->
# Generate Test Key. The key secret is shown once — put it in the backend
# environment only, never in the repo or the frontend.
# Going live later needs one-time merchant KYC (individual: PAN + address
# proof + bank account); a one-time Rs 199 + tax KYC fee may apply.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
