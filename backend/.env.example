NODE_ENV=development
PORT=4000
HOST=127.0.0.1
APP_ENCRYPTION_KEY=replace-with-a-long-random-secret
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=darkmatter
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5175
SESSION_DAYS=30
TOOL_REQUEST_TIMEOUT_MS=20000
RATE_LIMIT_MAX=120

PHONE_AI_HOST=
PHONE_AI_PORT=4891
PHONE_AI_BASE_URL=
PHONE_AI_ENABLED=true
PHONE_AI_MODEL=local
PHONE_AI_API_KEY=

# ─── Infinity Long-Context Engine ─────────────────────────────────
# The model context stays FINITE. These tune how DARKMATTER virtualizes
# application-level context around it.
PHONE_AI_CONTEXT_TOKENS=4096      # model-side window capacity (tokens)
LONG_CONTEXT_OUTPUT_RESERVE=768   # tokens always reserved for model output
LONG_CONTEXT_INPUT_THRESHOLD=8000 # chars above which input is ingested+chunked
LONG_CONTEXT_CHUNK_TARGET=6000    # target chars per stored chunk
LONG_CONTEXT_CHUNK_OVERLAP=200    # token-aware overlap between chunks
LONG_CONTEXT_SUMMARY_GROUP=4      # chunks per level-1 summary group
LONG_CONTEXT_PART_MAX_TOKENS=700  # max output tokens per generated part
LONG_CONTEXT_MAX_PARTS=120        # safety valve for generation loops
LONG_CONTEXT_REPAIR_LOOPS=2       # validation->repair iterations per artifact

# ─── Autonomous Bug Bounty Agent (persistent job worker) ──────────
# There are deliberately NO step/time/token quotas. These only control pacing,
# lease and recovery — never how much work a job may do.
AGENT_WORKER_AUTOSTART=true       # recover unfinished jobs on boot
AGENT_WORKER_RECOVER_ON_BOOT=true
AGENT_WORKER_IDLE_MS=500          # pause between reasoning steps
AGENT_WORKER_LEASE_MS=60000       # duplicate-execution guard
AGENT_WORKER_POLL_MS=500
AGENT_PHONE_RETRY_MS=15000        # retry cadence while the local AI is busy/offline
AGENT_CONTEXT_RETRY_MS=60000      # retry cadence after a context-window failure
AGENT_PHONE_MAX_CONCURRENCY=1     # hardware scheduler, not a quota
AGENT_BRAIN_MAX_TOKENS=700         # output reservation for one structured decision
AGENT_BRAIN_MEMORY_TOKENS=1400     # token budget for the retrieved memory block
AGENT_BRAIN_RETRIES=2              # schema-compliance retries per decision
AGENT_NO_PROGRESS_REPEAT_LIMIT=5   # liveness guard against spinning on one no-op

# ─── Computer Control (Open-Interface adapter) ─────────────────────
# Reuses Open-Interface's pyautogui/screenshot executor as DARKMATTER's "hands".
# It never calls an LLM; the local phone Gemma stays the only brain.
COMPUTER_CONTROL_ENABLED=false     # enable once pyautogui is installed on the host
COMPUTER_PYTHON_BIN=               # autodetect python3/python/py when empty
COMPUTER_BRIDGE_PATH=              # defaults to backend/computer/openInterfaceBridge.py
COMPUTER_ACTION_TIMEOUT_MS=60000
COMPUTER_PROBE_TIMEOUT_MS=20000
COMPUTER_REQUIRE_APPROVAL=true
COMPUTER_MAX_SCREENSHOT_BYTES=4000000
COMPUTER_SCREENSHOT_DIR=./data/computer

# Legacy in-request investigation loop. 0 = unlimited (no artificial step cap).
# The autonomous job worker never applies a step cap at all.
AGENT_MAX_ITERATIONS=0
