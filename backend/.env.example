# Copy to .env (local dev) or set as environment variables on Render.
# Never commit a real .env — see .gitignore.

# Port the backend listens on (Render injects PORT automatically).
PORT=4000

# ---- Hunt engine (PentAGI) bridge -------------------------------------------
ENGINE_URL=http://localhost:8080
ENGINE_TOKEN=
ENGINE_TIMEOUT_MS=8000

# ---- Voice service (Whisper/Piper) bridge -----------------------------------
VOICE_URL=http://localhost:8001
VOICE_TIMEOUT_MS=30000

# ---- Authorized targets (hunt creation gate) --------------------------------
# Comma-separated. Entries match a hunt target's hostname exactly, as a parent
# domain (covers subdomains), or as a full-URL prefix.
# Example: ALLOWED_TARGETS=example.com,https://staging.acme.io,api.internal.test
# EMPTY = hunt creation is disabled (all POST /api/v1/hunts -> 403).
ALLOWED_TARGETS=

# ---- Plugin API-key encryption ----------------------------------------------
# 64-hex-character (32-byte) key. Generate with: openssl rand -hex 32
# If unset, an ephemeral key is generated at boot (WARNING logged) and stored
# plugin keys do NOT survive restarts.
PLUGIN_MASTER_KEY=

# ---- Local data dir (plugin keys, model jobs, hunt event cache) -------------
DATA_DIR=./data

# WebSocket stream poll interval (ms) for the engine event bridge.
STREAM_POLL_MS=1000
